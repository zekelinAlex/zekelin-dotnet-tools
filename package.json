{
  "name": "zekelin-dotnet-tools",
  "displayName": "Zekelin .NET Tools",
  "description": ".NET developer toolbox: publish, wipe bin/obj, scoped git push/discard, NuGet cache, and more.",
  "version": "0.0.1",
  "publisher": "alex",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dotnet-cleanup",
          "title": "Zekelin .NET Tools",
          "icon": "resources/zekelin-icon.svg"
        }
      ]
    },
    "views": {
      "dotnet-cleanup": [
        {
          "id": "dotnetCleanupActions",
          "name": "Actions"
        },
        {
          "id": "zekelinDevkitBuildActions",
          "name": "tools-devkit-build",
          "when": "zekelin.isDevkitBuild"
        },
        {
          "id": "zekelinDataverseActions",
          "name": "Dataverse"
        },
        {
          "id": "zekelinToolsCliActions",
          "name": "tools-cli",
          "when": "zekelin.isToolsCli"
        }
      ]
    },
    "commands": [
      {
        "command": "dotnet-cleanup.clearNugetCache",
        "title": "Clear NuGet Cache"
      },
      {
        "command": "dotnet-cleanup.killDotnetProcesses",
        "title": "Kill .NET Processes"
      },
      {
        "command": "dotnet-cleanup.killVBCSCompiler",
        "title": "Kill VBCSCompiler"
      },
      {
        "command": "dotnet-cleanup.dotnetWipe",
        "title": ".NET Wipe"
      },
      {
        "command": "dotnet-cleanup.dotnetPublish",
        "title": "Publish"
      },
      {
        "command": "dotnet-cleanup.generateSnippetPrefixes",
        "title": "Generate Snippet Prefixes"
      },
      {
        "command": "dotnet-cleanup.gitPush",
        "title": "Push"
      },
      {
        "command": "dotnet-cleanup.gitDiscard",
        "title": "Discard"
      },
      {
        "command": "dotnet-cleanup.installTargetNugets",
        "title": "Install targets Nugets"
      },
      {
        "command": "dotnet-cleanup.generateInstallScript",
        "title": "Generate Install Script"
      },
      {
        "command": "dotnet-cleanup.dataverseSolutionUnpack",
        "title": "Dataverse Solutions unpack"
      },
      {
        "command": "dotnet-cleanup.dataverseSolutionImport",
        "title": "Dataverse Solutions Import"
      },
      {
        "command": "dotnet-cleanup.dataversePackageDeploy",
        "title": "Dataverse Package deploy"
      },
      {
        "command": "dotnet-cleanup.addDataverseEnvironment",
        "title": "Add Dataverse environment",
        "icon": "$(add)"
      },
      {
        "command": "dotnet-cleanup.createDataverseEnvironment",
        "title": "Create Dataverse environment",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "dotnet-cleanup.deleteDataverseEnvironment",
        "title": "Delete Dataverse environment",
        "icon": "$(trash)"
      },
      {
        "command": "dotnet-cleanup.openInNewWindow",
        "title": "Open in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "dotnet-cleanup.revealDataverseEnvironmentsConfig",
        "title": "Reveal Dataverse environments config",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dotnet-cleanup.sendToLocalNugetFeed",
        "title": "Send to Local NuGet Feed",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "dotnet-cleanup.sortExplorerByModified",
        "title": "Sort Explorer by modified date",
        "icon": "$(history)"
      },
      {
        "command": "dotnet-cleanup.sortExplorerByDefault",
        "title": "Sort Explorer alphabetically",
        "icon": "$(case-sensitive)"
      },
      {
        "command": "dotnet-cleanup.toolsCliReinstallLocal",
        "title": "tools-cli: Reinstall Local"
      },
      {
        "command": "dotnet-cleanup.toolsCliReinstallLocalWithMcp",
        "title": "tools-cli: Reinstall Local (with MCP)"
      },
      {
        "command": "dotnet-cleanup.toolsCliGenerateScript",
        "title": "tools-cli: Generate Reinstall Script"
      },
      {
        "command": "dotnet-cleanup.resendLastCommit",
        "title": "Resend last commit (refresh timestamp)"
      },
      {
        "command": "dotnet-cleanup.combineCommits",
        "title": "Combine commits (squash into first)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dotnet-cleanup.sendToLocalNugetFeed",
          "when": "resourceScheme == file && resourceExtname == .nupkg",
          "group": "1_zekelin_nuget@0"
        },
        {
          "command": "dotnet-cleanup.dotnetPublish",
          "when": "resourcePath in dotnetCleanup.publishTargets",
          "group": "dotnet-cleanup@0"
        },
        {
          "command": "dotnet-cleanup.dotnetWipe",
          "when": "resourcePath in dotnetCleanup.wipeTargets",
          "group": "dotnet-cleanup@1"
        },
        {
          "command": "dotnet-cleanup.generateSnippetPrefixes",
          "when": "explorerResourceIsFolder && resourceFilename == .vscode",
          "group": "dotnet-cleanup@2"
        },
        {
          "command": "dotnet-cleanup.gitPush",
          "when": "resourceScheme == file && resourcePath in dotnetGit.changedPaths",
          "group": "dotnet-git@0"
        },
        {
          "command": "dotnet-cleanup.gitDiscard",
          "when": "resourceScheme == file && resourcePath in dotnetGit.changedPaths",
          "group": "dotnet-git@1"
        },
        {
          "command": "dotnet-cleanup.dataverseSolutionUnpack",
          "when": "resourceScheme == file && resourceExtname == .zip",
          "group": "dotnet-dataverse@0"
        },
        {
          "command": "dotnet-cleanup.dataverseSolutionImport",
          "when": "resourceScheme == file && resourceExtname == .zip",
          "group": "dotnet-dataverse@1"
        },
        {
          "command": "dotnet-cleanup.dataversePackageDeploy",
          "when": "resourceScheme == file && resourceExtname == .zip",
          "group": "dotnet-dataverse@2"
        },
        {
          "command": "dotnet-cleanup.openInNewWindow",
          "when": "resourceScheme == file",
          "group": "z_zekelin_openInNewWindow@0"
        }
      ],
      "view/title": [
        {
          "command": "dotnet-cleanup.sortExplorerByModified",
          "when": "view == workbench.explorer.fileView && !zekelin.explorerSortByModified",
          "group": "navigation@99"
        },
        {
          "command": "dotnet-cleanup.sortExplorerByDefault",
          "when": "view == workbench.explorer.fileView && zekelin.explorerSortByModified",
          "group": "navigation@99"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/sinon": "^17.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "mocha": "^10.0.0",
    "sinon": "^17.0.0",
    "typescript": "^5.0.0"
  }
}
